# Godot 4+ specific ignores
.godot/
/android/
.vscode/
steam_appid.txt
build
/artifacts/
/tools/ab_test/.runtime/
/tools/ab_test/vm-endpoint.local.psd1
/.tmp-*/
/addons/godotsteam/win64/~*.TMP
/addons/GodotGAS/**/*.import

# .NET build output
bin/
obj/

# Godot generates UID metadata for C# files it scans. Test-only source is not a Godot script surface.
/tests/GameFactory.Tests/**/*.cs.uid
# Aider runtime state. Project configuration and .aiderignore are tracked.
/.aider*
!/.aider.conf.yml
!/.aider.model.settings.yml
!/.aiderignore
